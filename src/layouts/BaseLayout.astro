---
import '@ds/styles.css';
import SiteHeader from '@components/SiteHeader.jsx';
import SiteFooter from '@components/SiteFooter.astro';

const { title, description = 'AI automation for small service businesses — life coaches, chiropractors, consultants, practitioners.' } = Astro.props;
const pageTitle = title ? `${title} — Amplio Systems` : 'Amplio Systems — Automate the mundane. Amplify what matters.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/mark.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader client:load page={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  html, body { margin: 0; }
  body { background: var(--surface-page); }

  @keyframes amplio-spin { to { transform: rotate(360deg); } }
  @keyframes amplio-fade { from { opacity: 0; } }
  @keyframes amplio-rise { from { opacity: 0; transform: translateY(12px); } }

  .site-nav { display: flex; }
  .site-burger { display: none; }
  @media (max-width: 820px) {
    .site-nav { display: none !important; }
    .site-burger { display: inline-flex !important; }
  }

  /* Shared responsive utilities for the fixed-ratio grids used throughout the marketing pages
     (e.g. `gridTemplateColumns: '0.8fr 1.2fr'`). These are set inline per-page for the desktop
     layout; the classes below collapse them on narrow viewports. `!important` is required
     because inline styles otherwise beat an external stylesheet regardless of selector. */
  @media (max-width: 820px) {
    .grid-stack-md { grid-template-columns: 1fr !important; }

    /* For grids of items separated by a left border (a divider between side-by-side columns).
       Stacked to one column, that divider should run along the top of each item instead. */
    .divider-cols > * { border-left: none !important; border-top: 1px solid var(--border-subtle) !important; padding-left: 0 !important; padding-top: var(--space-6) !important; margin-top: var(--space-6) !important; }
    .divider-cols > *:first-child { border-top: none !important; padding-top: 0 !important; margin-top: 0 !important; }
    .divider-cols-inverse > * { border-left: none !important; border-top: 1px solid var(--border-inverse) !important; padding-left: 0 !important; padding-top: var(--space-6) !important; margin-top: var(--space-6) !important; }
    .divider-cols-inverse > *:first-child { border-top: none !important; padding-top: 0 !important; margin-top: 0 !important; }

    .text-center-mobile { text-align: center !important; }
  }
  @media (max-width: 540px) {
    .grid-stack-sm { grid-template-columns: 1fr !important; }
  }
</style>
