---
/* /atlas/pilot/ — Atlas pilot application.
   Reached from the "Join the pilot" CTAs on the Atlas page.
   The pilot's commercial terms (length, cost, cohort size, start date) were not supplied, so
   nothing is promised here beyond what we know: applications are open and housing associations
   are the first cohort. Add the real terms when they exist. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@components/Section.jsx';
import { Card } from '@ds/components/core/Card.jsx';
import { Icon } from '@ds/components/core/Icon.jsx';
import { Eyebrow } from '@ds/components/marketing/Eyebrow.jsx';
import { SectionHeading } from '@ds/components/marketing/SectionHeading.jsx';
import PilotForm from '@components/atlas/PilotForm.jsx';

const WHY = [
  ['list-checks', 'You tell us what decisions are hardest', 'We start from your real questions, not a feature list.'],
  ['users', 'You see it early and shape it', 'Working sessions with the people building it.'],
  ['shield-check', 'No commitment on either side', 'Applying is a conversation. Nothing is signed.'],
];
---
<BaseLayout title="Atlas pilot" description="Atlas is at concept stage. We're looking for a small number of housing providers to shape it with us.">

  <Section tone="page" tight style={{ paddingTop: 'var(--space-24)' }}>
    <div style={{ display: 'grid', gridTemplateColumns: '0.8fr 1.2fr', gap: 'var(--space-20)', alignItems: 'start' }}>
      <div>
        <SectionHeading eyebrow="Atlas pilot" level={1} title="Help us build Atlas properly" maxWidth={400}
          description="Atlas is at concept stage. We're looking for a small number of housing providers to shape it with us — the people who will actually use it, deciding what it needs to answer." />

        <div style={{ display: 'grid', gap: 'var(--space-5)', marginTop: 'var(--space-10)' }}>
          {WHY.map(([icon, title, body]) => (
            <div key={title} style={{ display: 'flex', gap: 'var(--space-4)', alignItems: 'flex-start' }}>
              <span style={{ width: '40px', height: '40px', flex: 'none', borderRadius: 'var(--radius-leaf)', background: 'var(--sage-mist)', color: 'var(--deep-fern)', display: 'grid', placeItems: 'center' }}>
                <Icon name={icon} size={19} />
              </span>
              <div>
                <div style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', fontWeight: 'var(--weight-bold)', color: 'var(--text-heading)' }}>{title}</div>
                <div style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', lineHeight: 'var(--leading-normal)', color: 'var(--text-body)', marginTop: '2px' }}>{body}</div>
              </div>
            </div>
          ))}
        </div>

        <Card variant="sage" padding="lg" style={{ marginTop: 'var(--space-10)' }}>
          <Eyebrow style={{ marginBottom: 'var(--space-3)' }}>Being straight with you</Eyebrow>
          <p style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', lineHeight: 'var(--leading-relaxed)', color: 'var(--text-body)', margin: 0 }}>
            Our first cohort is housing associations. Local authorities and other organisations are
            genuinely welcome to apply — we'll hold your details for the next phase rather than
            pretend otherwise.
          </p>
        </Card>
      </div>

      <Card variant="raised" padding="lg">
        <PilotForm client:load />
      </Card>
    </div>
  </Section>

</BaseLayout>
