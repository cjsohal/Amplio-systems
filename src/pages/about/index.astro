---
import React from 'react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@components/Section.jsx';
import { Card } from '@ds/components/core/Card.jsx';
import { Icon } from '@ds/components/core/Icon.jsx';
import { Logo } from '@ds/components/core/Logo.jsx';
import { Eyebrow } from '@ds/components/marketing/Eyebrow.jsx';
import { SectionHeading } from '@ds/components/marketing/SectionHeading.jsx';
import { Testimonial } from '@ds/components/marketing/Testimonial.jsx';
import { StatBlock } from '@ds/components/marketing/StatBlock.jsx';
import { CTABanner } from '@ds/components/marketing/CTABanner.jsx';
import { BOOKING_URL } from '@data/site.js';

const VALUES = [
  { n: '01', icon: 'shield-check', title: 'Integrity', body: 'Honest about where and how we can help — and where we cannot.' },
  { n: '02', icon: 'leaf', title: 'Simplicity', body: 'Making complex automation accessible and clear.' },
  { n: '03', icon: 'zap', title: 'Brave', body: "Stretching the boundaries of what's possible." },
  { n: '04', icon: 'sparkles', title: 'Fun', body: 'Making the process enjoyable rather than laborious.' },
];

/* SectionHeading's title/description accept a React node, not just a string — used here to
   italicise and colour a phrase in each, matching the emphasis style requested for this hero.
   Built with React.createElement rather than JSX because Astro's own <>...</> template syntax
   produces an Astro-internal chunk object here, not a real React element (see the note on the
   Atlas page, which hit the same issue first). */
const aboutTitle = React.createElement(React.Fragment, null,
  'Amplio is Latin: to ',
  React.createElement('em', { style: { fontStyle: 'italic', color: 'var(--amplio-green)' } }, 'enlarge, extend, multiply'));

const aboutDescription = React.createElement(React.Fragment, null,
  'We chose it because the point was never speed. It was room — room to think, to grow, to do the work you actually care about. ',
  React.createElement('strong', { style: { color: 'var(--deep-fern)', fontWeight: 'var(--weight-bold)' } }, '“Systems” keeps us honest about the method'),
  '; the warmth is the part most automation forgets.');
---
<BaseLayout title="About" description="Amplio is Latin: to enlarge, extend, multiply. We chose it because the point was never speed. It was room — room to think, to grow, to do the work you actually care about.">

  <Section tone="page" tight style={{ paddingTop: 'var(--space-24)' }}>
    <div class="about-hero-grid" style={{ display: 'grid', gridTemplateColumns: '1.2fr 0.8fr', gap: 'var(--space-20)', alignItems: 'center' }}>
      <SectionHeading eyebrow="About" level={1} maxWidth={560}
        title={aboutTitle}
        description={aboutDescription} />
      <div style={{ display: 'grid', placeItems: 'center' }}>
        <img src="/assets/amplio-globe.png" alt="A globe illustration surrounded by icon tiles for data, technology, insight, people, strategy and impact" style={{ width: 'min(420px,100%)' }} />
      </div>
    </div>
  </Section>

  <Section tone="sage">
    <SectionHeading eyebrow="Core values" title="In priority order, and we mean the order"
      description="When two of these pull against each other, the one higher up wins." />
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(220px,1fr))', gap: 'var(--space-5)', marginTop: 'var(--space-12)' }}>
      {VALUES.map((v) => (
        <Card key={v.n} variant="raised" padding="lg">
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
            <span style={{ width: '46px', height: '46px', borderRadius: 'var(--radius-leaf)', background: 'var(--green-50)', color: 'var(--deep-fern)', display: 'grid', placeItems: 'center' }}>
              <Icon name={v.icon} size={22} />
            </span>
            <Eyebrow tone="muted">{v.n}</Eyebrow>
          </div>
          <h3 style={{ fontFamily: 'var(--font-display)', fontSize: 'var(--text-xl)', margin: 'var(--space-6) 0 6px', color: 'var(--text-heading)' }}>{v.title}</h3>
          <p style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', lineHeight: 'var(--leading-relaxed)', margin: 0, color: 'var(--text-body)' }}>{v.body}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="page">
    <div style={{ display: 'grid', gridTemplateColumns: '0.9fr 1.1fr', gap: 'var(--space-20)', alignItems: 'start' }}>
      <SectionHeading eyebrow="Who we work with" title="Small practices where the owner is still the product" maxWidth={400}
        description="Life coaches, local businesses, consultants, practitioners. People whose time is the thing being sold, and whose admin is therefore the most expensive thing in the business." />
      <div style={{ display: 'grid', gap: 'var(--space-8)' }}>
        <Testimonial quote="Amplio Systems have helped me streamline my marketing and customer data analysis. Couldn't have it done without you, thanks CJ!"
          name="Sarah James" role="Marketing expert" />
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 'var(--space-8)', borderTop: '1px solid var(--border-subtle)', paddingTop: 'var(--space-8)' }}>
          <StatBlock value="Reassured" label="How clients say they feel after the first call" />
          <StatBlock value="Relaxed" label="How they describe the build weeks" />
          <StatBlock value="Comfortable" label="Using the system with ongoing support" />
        </div>
      </div>
    </div>
  </Section>

  <Section tone="ink" tight>
    <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 'var(--space-16)', alignItems: 'center' }}>
      <div>
        <Eyebrow tone="inverse" style={{ marginBottom: 'var(--space-5)' }}>What we believe</Eyebrow>
        <p style={{ fontFamily: 'var(--font-display)', fontSize: 'clamp(24px,2.6vw,34px)', lineHeight: 'var(--leading-snug)', color: 'var(--text-inverse)', margin: 0 }}>
          Technology should serve people, not the other way around. We bring warmth to automation, and we create space rather than just speed.
        </p>
      </div>
      <div style={{ display: 'grid', placeItems: 'center' }}>
        <Logo variant="mark-cream" height={150} style={{ opacity: 0.9 }} />
      </div>
    </div>
  </Section>

  <Section tone="page" tight>
    <CTABanner tone="sage" eyebrow="Say hello" title="Come and tell us what your week looks like"
      description="No form-filling marathon. One conversation, and an honest answer about whether we can help."
      primaryLabel="Book a discovery call" primaryHref={BOOKING_URL} primaryProps={{ target: '_blank', rel: 'noopener noreferrer' }} />
  </Section>

</BaseLayout>

<style>
  @media (max-width: 820px) {
    .about-hero-grid { grid-template-columns: 1fr !important; }
  }
</style>
