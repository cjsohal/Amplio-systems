---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@components/Section.jsx';
import { Button } from '@ds/components/core/Button.jsx';
import { Badge } from '@ds/components/core/Badge.jsx';
import { Card } from '@ds/components/core/Card.jsx';
import { Icon } from '@ds/components/core/Icon.jsx';
import { Eyebrow } from '@ds/components/marketing/Eyebrow.jsx';
import { SectionHeading } from '@ds/components/marketing/SectionHeading.jsx';
import { FeatureCard } from '@ds/components/marketing/FeatureCard.jsx';
import { StatBlock } from '@ds/components/marketing/StatBlock.jsx';
import { Testimonial } from '@ds/components/marketing/Testimonial.jsx';
import { CTABanner } from '@ds/components/marketing/CTABanner.jsx';
import { Accordion } from '@ds/components/navigation/Accordion.jsx';

const HOME_STEPS = [
  { n: '01', icon: 'search', title: 'We map your week', body: 'A short audit of where your hours actually go. No tools, no changes — just an honest picture.' },
  { n: '02', icon: 'workflow', title: 'We build the system', body: 'Two weeks of building and testing on the tools you already own, alongside you rather than around you.' },
  { n: '03', icon: 'heart-handshake', title: 'We hand it over', body: 'You keep the system, the logins and the documentation. We stay reachable, not required.' },
];

const FAQ = [
  { id: 'q1', question: 'How long does setup take?', answer: 'Most systems are live inside three weeks — one week mapping, two building and testing alongside you.' },
  { id: 'q2', question: 'Will I need to change the tools I already use?', answer: 'Rarely. We build around your calendar, inbox and booking system rather than replacing them.' },
  { id: 'q3', question: 'What if automation is the wrong answer?', answer: "We'll tell you. Integrity comes first, and some problems are cheaper to solve by changing a process than by building anything." },
  { id: 'q4', question: 'What happens after handover?', answer: "You own the system, the logins and the documentation. We're reachable if something changes, but you are not dependent on us." },
];
---
<BaseLayout title="Home" description="AI automation for small service businesses. We systemise the tedious work that drains your week — intake, invoicing, follow-up — so you can get back to the part of the job you actually trained for.">

  <div style={{ position: 'relative', overflow: 'hidden', background: 'var(--gradient-hero)', color: 'var(--text-inverse)' }}>
    <div aria-hidden="true" style={{
      position: 'absolute', inset: 0, display: 'grid', placeItems: 'end start', padding: 20,
      border: '1px dashed var(--alpha-cream-24)', margin: 12, borderRadius: 'var(--radius-xl)',
    }}>
      <span style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-2xs)', letterSpacing: 'var(--tracking-eyebrow)', textTransform: 'uppercase', color: 'var(--alpha-cream-24)' }}>
        Video slot &middot; no footage supplied
      </span>
    </div>
    <img src="/assets/mark-light.svg" alt="" aria-hidden="true"
      style={{ position: 'absolute', right: '-8%', top: '-30%', width: 'min(680px, 58%)', opacity: 0.14 }} />
    <div style={{ position: 'relative', maxWidth: 'var(--container-xl)', margin: '0 auto', padding: 'var(--space-40) var(--space-8) var(--space-32)' }}>
      <Badge tone="brand" icon="leaf" style={{ background: 'var(--alpha-cream-12)', color: 'var(--warm-cream)', borderColor: 'var(--alpha-cream-24)' }}>
        AI automation for small practices
      </Badge>
      <h1 style={{
        fontFamily: 'var(--font-display)', fontWeight: 'var(--weight-display)',
        fontSize: 'clamp(40px, 6vw, 82px)', lineHeight: 'var(--leading-tight)',
        color: 'var(--text-inverse)', margin: 'var(--space-6) 0 0', maxWidth: 900,
      }}>
        Automate the mundane.<br />Amplify what matters.
      </h1>
      <p style={{
        fontFamily: 'var(--font-body)', fontSize: 'clamp(17px, 1.5vw, 21px)',
        lineHeight: 'var(--leading-relaxed)', color: 'var(--text-inverse-muted)',
        margin: 'var(--space-8) 0 0', maxWidth: 620,
      }}>
        We systemise the tedious work that drains your week — intake, invoicing, follow-up —
        so you can get back to the part of the job you actually trained for.
      </p>
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: 'var(--space-3)', marginTop: 'var(--space-10)' }}>
        <Button variant="inverse" size="lg" iconRight="arrow-right" data-open-booking>Book a discovery call</Button>
        <Button variant="ghost" size="lg" href="/ai-automation/"
          style={{ color: 'var(--warm-cream)', border: '1px solid var(--alpha-cream-24)' }}>See how it works</Button>
      </div>
    </div>
  </div>

  <Section tone="page">
    <SectionHeading eyebrow="What we do" title="Systems that quietly hold your business together"
      description="Four things drain most small practices: chasing enquiries, chasing money, chasing follow-ups, and remembering everything in between. We take them off your desk." />
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(250px,1fr))', gap: 'var(--space-6)', marginTop: 'var(--space-12)' }}>
      <FeatureCard icon="inbox" title="Client intake, handled">Enquiries answered, qualified and booked without you touching your inbox.</FeatureCard>
      <FeatureCard icon="file-text" title="Invoices that chase themselves">Sent on time, followed up politely, reconciled quietly.</FeatureCard>
      <FeatureCard icon="repeat" title="Follow-up that never slips">The check-in you meant to send three weeks ago, sent.</FeatureCard>
      <FeatureCard icon="list-checks" title="The admin nobody sees">Notes filed, reminders set, records where you'll find them.</FeatureCard>
    </div>
  </Section>

  <Section tone="sage">
    <div style={{ display: 'grid', gridTemplateColumns: '0.9fr 1.1fr', gap: 'var(--space-20)', alignItems: 'start' }}>
      <SectionHeading eyebrow="How it works" title="Three weeks, three steps, no upheaval" maxWidth={420}
        description="We don't replace the tools you like. We connect them, then remove the bits you were doing by hand." />
      <div style={{ display: 'grid', gap: 'var(--space-4)' }}>
        {HOME_STEPS.map((s) => (
          <Card key={s.n} variant="raised" padding="lg" style={{ display: 'flex', gap: 'var(--space-6)', alignItems: 'flex-start' }}>
            <span style={{ width: 48, height: 48, flex: 'none', borderRadius: 'var(--radius-leaf)', background: 'var(--green-50)', color: 'var(--deep-fern)', display: 'grid', placeItems: 'center' }}>
              <Icon name={s.icon} size={22} />
            </span>
            <div>
              <Eyebrow style={{ marginBottom: 6 }}>{s.n}</Eyebrow>
              <h3 style={{ fontFamily: 'var(--font-display)', fontSize: 'var(--text-xl)', margin: '0 0 6px', color: 'var(--text-heading)' }}>{s.title}</h3>
              <p style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', lineHeight: 'var(--leading-relaxed)', margin: 0, color: 'var(--text-body)' }}>{s.body}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <Section tone="page" tight>
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 'var(--space-12)' }}>
      <StatBlock value="11 hrs" label="Average admin time returned per week across our first cohort" />
      <StatBlock value="3 wks" label="From first call to a working system, start to finish" />
      <StatBlock value="No lock-in" label="Built on tools you already own, documented and handed over" />
    </div>
  </Section>

  <Section tone="card">
    <div style={{ maxWidth: 760, margin: '0 auto' }}>
      <Testimonial quote="I stopped dreading Monday mornings. The week starts and the admin has already happened."
        name="Priya Raman" role="Life coach, Bristol" />
    </div>
  </Section>

  <Section tone="page">
    <div style={{ display: 'grid', gridTemplateColumns: '0.8fr 1.2fr', gap: 'var(--space-20)', alignItems: 'start' }}>
      <SectionHeading eyebrow="Questions" title="The things people ask us first" maxWidth={340} />
      <Accordion client:load defaultOpen={['q1']} items={FAQ} />
    </div>
  </Section>

  <Section tone="page" tight>
    <CTABanner eyebrow="Next step" title="Let's find the hour you've been losing every day"
      description="A thirty-minute call. We'll map what's worth automating, and tell you honestly if it isn't us."
      primaryLabel="Book a discovery call" primaryProps={{ 'data-open-booking': true }}
      secondaryLabel="See our services" secondaryHref="/ai-automation/" />
  </Section>

</BaseLayout>
