---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@components/Section.jsx';
import { Card } from '@ds/components/core/Card.jsx';
import { Icon } from '@ds/components/core/Icon.jsx';
import { Eyebrow } from '@ds/components/marketing/Eyebrow.jsx';
import { SectionHeading } from '@ds/components/marketing/SectionHeading.jsx';
import { Button } from '@ds/components/core/Button.jsx';
import ContactForm from '@components/contact/ContactForm.jsx';
---
<BaseLayout title="Contact" description="Tell us what's draining your week. We read everything that comes in — you'll hear back from a person, usually the same day.">

  <Section tone="page" tight style={{ paddingTop: 'var(--space-24)' }}>
    <div style={{ display: 'grid', gridTemplateColumns: '0.85fr 1.15fr', gap: 'var(--space-20)', alignItems: 'start' }}>
      <div>
        <SectionHeading eyebrow="Contact" level={1} title="Tell us what's draining your week" maxWidth={420}
          description="We read everything that comes in. You'll hear back from a person, usually the same day." />
        <div style={{ display: 'grid', gap: 'var(--space-4)', marginTop: 'var(--space-10)' }}>
          {[['mail', 'info@ampliosystemsltd.com'], ['globe', 'ampliosystemsltd.com'], ['clock', 'Replies weekdays, 9am–6pm']].map(([i, t]) => (
            <div key={t} style={{ display: 'flex', gap: '12px', alignItems: 'center', fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', color: 'var(--text-body)' }}>
              <Icon name={i} size={18} style={{ color: 'var(--amplio-green)' }} />{t}
            </div>
          ))}
        </div>
        <Card variant="sage" padding="lg" style={{ marginTop: 'var(--space-10)' }}>
          <Eyebrow style={{ marginBottom: 'var(--space-3)' }}>Prefer to talk</Eyebrow>
          <p style={{ fontFamily: 'var(--font-display)', fontSize: 'var(--text-lg)', lineHeight: 'var(--leading-snug)', margin: '0 0 var(--space-5)', color: 'var(--text-heading)' }}>
            Thirty minutes, no pitch.
          </p>
          <Button variant="secondary" fullWidth iconRight="calendar-check" data-open-booking>Book a discovery call</Button>
        </Card>
      </div>

      <Card variant="raised" padding="lg">
        <ContactForm client:load />
      </Card>
    </div>
  </Section>

</BaseLayout>
