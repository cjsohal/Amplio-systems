---
import Section from '@components/Section.jsx';
import { Button } from '@ds/components/core/Button.jsx';
import { Card } from '@ds/components/core/Card.jsx';
import { Icon } from '@ds/components/core/Icon.jsx';
import { Eyebrow } from '@ds/components/marketing/Eyebrow.jsx';
import { SectionHeading } from '@ds/components/marketing/SectionHeading.jsx';
import { CTABanner } from '@ds/components/marketing/CTABanner.jsx';
import { Accordion } from '@ds/components/navigation/Accordion.jsx';

const { d } = Astro.props;
---
<div style={{ position: 'relative', overflow: 'hidden', background: 'var(--gradient-hero)', color: 'var(--text-inverse)' }}>
  <img src="/assets/mark-light.svg" alt="" aria-hidden="true"
    style={{ position: 'absolute', right: '-7%', top: '-32%', width: 'min(560px, 50%)', opacity: 0.14 }} />
  <div style={{ position: 'relative', maxWidth: 'var(--container-xl)', margin: '0 auto', padding: 'var(--space-32) var(--space-8) var(--space-24)' }}>
    <Eyebrow tone="inverse" style={{ marginBottom: 'var(--space-5)' }}>{d.eyebrow}</Eyebrow>
    <h1 style={{ fontFamily: 'var(--font-display)', fontWeight: 'var(--weight-display)', fontSize: 'clamp(36px,5vw,66px)', lineHeight: 'var(--leading-tight)', color: 'var(--text-inverse)', margin: 0, maxWidth: 820 }}>
      {d.headline}
    </h1>
    <p style={{ fontFamily: 'var(--font-body)', fontSize: 'clamp(17px,1.5vw,21px)', lineHeight: 'var(--leading-relaxed)', color: 'var(--text-inverse-muted)', margin: 'var(--space-8) 0 0', maxWidth: 640 }}>
      {d.promise}
    </p>
    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 'var(--space-3)', marginTop: 'var(--space-10)' }}>
      <Button variant="inverse" size="lg" iconRight="arrow-right" href="/contact/">Get in touch</Button>
      <Button variant="ghost" size="lg" href="#detail" style={{ color: 'var(--warm-cream)', border: '1px solid var(--alpha-cream-24)' }}>See how it works</Button>
    </div>
  </div>
</div>

<Section tone="page">
  <div style={{ display: 'grid', gridTemplateColumns: '0.95fr 1.05fr', gap: 'var(--space-16)', alignItems: 'start' }}>
    <SectionHeading eyebrow={d.gapEyebrow} title={d.gapTitle} description={d.gapBody} maxWidth={440} />
    <div style={{ display: 'grid', gap: 'var(--space-4)' }}>
      {d.gapPoints.map(([icon, title, body]) => (
        <Card key={title} variant="raised" padding="lg" style={{ display: 'flex', gap: 'var(--space-5)', alignItems: 'flex-start' }}>
          <span style={{ width: 46, height: 46, flex: 'none', borderRadius: 'var(--radius-leaf)', background: 'var(--green-50)', color: 'var(--deep-fern)', display: 'grid', placeItems: 'center' }}>
            <Icon name={icon} size={21} />
          </span>
          <div>
            <div style={{ fontFamily: 'var(--font-display)', fontSize: 'var(--text-lg)', color: 'var(--text-heading)' }}>{title}</div>
            <p style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', lineHeight: 'var(--leading-relaxed)', color: 'var(--text-body)', margin: '4px 0 0', maxWidth: 'none' }}>{body}</p>
          </div>
        </Card>
      ))}
    </div>
  </div>
</Section>

<Section tone="sage" style={{ scrollMarginTop: 80 }}>
  <div id="detail" style={{ display: 'grid', gridTemplateColumns: '1.1fr 0.9fr', gap: 'var(--space-16)', alignItems: 'start' }}>
    <div>
      <SectionHeading eyebrow={d.doesEyebrow} title={d.doesTitle} maxWidth={480} />
      <div style={{ display: 'grid', gap: 'var(--space-4)', marginTop: 'var(--space-8)' }}>
        {d.does.map((t) => (
          <div key={t} style={{ display: 'flex', gap: 12, alignItems: 'flex-start' }}>
            <Icon name="check" size={18} style={{ color: 'var(--amplio-green)', marginTop: 3 }} />
            <span style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-base)', lineHeight: 'var(--leading-normal)', color: 'var(--text-body)' }}>{t}</span>
          </div>
        ))}
      </div>
    </div>
    <Card variant="raised" padding="lg">
      <Eyebrow style={{ marginBottom: 'var(--space-4)' }}>Where we draw the line</Eyebrow>
      <p style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-base)', lineHeight: 'var(--leading-relaxed)', color: 'var(--text-body)', margin: 0, maxWidth: 'none' }}>
        {d.escalation}
      </p>
    </Card>
  </div>
</Section>

<Section tone="page">
  <SectionHeading eyebrow={d.stepsEyebrow} title={d.stepsTitle} />
  <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 'var(--space-6)', marginTop: 'var(--space-12)' }}>
    {d.steps.map(([icon, title, body], i) => (
      <Card key={title} variant="raised" padding="lg" style={{ height: '100%' }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
          <span style={{ width: 48, height: 48, borderRadius: 'var(--radius-leaf)', background: 'var(--green-50)', color: 'var(--deep-fern)', display: 'grid', placeItems: 'center' }}>
            <Icon name={icon} size={22} />
          </span>
          <Eyebrow tone="muted">{`0${i + 1}`}</Eyebrow>
        </div>
        <h3 style={{ fontFamily: 'var(--font-display)', fontSize: 'var(--text-xl)', lineHeight: 'var(--leading-snug)', color: 'var(--text-heading)', margin: 'var(--space-6) 0 var(--space-2)' }}>{title}</h3>
        <p style={{ fontFamily: 'var(--font-body)', fontSize: 'var(--text-sm)', lineHeight: 'var(--leading-relaxed)', color: 'var(--text-body)', margin: 0, maxWidth: 'none' }}>{body}</p>
      </Card>
    ))}
  </div>
</Section>

<Section tone="page" tight style={{ paddingTop: 0 }}>
  <div style={{ display: 'grid', gridTemplateColumns: '0.8fr 1.2fr', gap: 'var(--space-20)', alignItems: 'start' }}>
    <SectionHeading eyebrow="Questions" title="The things people ask us first" maxWidth={320} />
    <Accordion client:load defaultOpen={[d.faq[0][0]]}
      items={d.faq.map(([fid, question, answer]) => ({ id: fid, question, answer }))} />
  </div>
</Section>

<Section tone="page" tight>
  <CTABanner eyebrow="Next step" title={d.ctaTitle} description={d.ctaBody}
    primaryLabel="Book a discovery call" primaryProps={{ 'data-open-booking': true }}
    secondaryLabel="See all services" secondaryHref="/ai-automation/" />
</Section>
