---
import { Logo } from '@ds/components/core/Logo.jsx';
import { Eyebrow } from '@ds/components/marketing/Eyebrow.jsx';
import { Icon } from '@ds/components/core/Icon.jsx';
import { NAV } from '@components/SiteHeader.jsx';

const serviceLinks = [
  { href: '/ai-automation/ai-powered-reviews/', label: 'AI Powered Reviews' },
  { href: '/ai-automation/ai-voice-receptionist/', label: 'AI Voice Receptionist' },
  { href: '/ai-automation/ai-seo/', label: 'AI SEO' },
  { href: '/ai-automation/ai-strategy/', label: 'AI Strategy' },
];
---

<footer style="background: var(--surface-ink); color: var(--text-inverse); padding: var(--space-24) var(--space-8) var(--space-10);">
  <div style="max-width: var(--container-xl); margin: 0 auto;">
    <div class="footer-grid">
      <div>
        <Logo variant="lockup-light" height={38} />
        <p style="font-family: var(--font-display); font-size: var(--text-lg); color: var(--text-inverse); margin: var(--space-6) 0 0; max-width: 320px; line-height: var(--leading-snug);">
          Automate the mundane.<br />Amplify what matters.
        </p>
      </div>
      <div>
        <Eyebrow tone="inverse" style={{ marginBottom: 'var(--space-5)' }}>Site</Eyebrow>
        <div style="display: grid; gap: var(--space-3);">
          {NAV.map((n) => (
            <a href={n.href} style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-inverse-muted); text-decoration: none;">{n.label}</a>
          ))}
          {serviceLinks.map((s) => (
            <a href={s.href} style="font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-inverse-muted); text-decoration: none;">{s.label}</a>
          ))}
        </div>
      </div>
      <div>
        <Eyebrow tone="inverse" style={{ marginBottom: 'var(--space-5)' }}>Get in touch</Eyebrow>
        <div style="display: grid; gap: var(--space-3); font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-inverse-muted);">
          <span style="display: flex; gap: 8px; align-items: center;"><Icon name="mail" size={16} /> info@ampliosystemsltd.com</span>
          <span style="display: flex; gap: 8px; align-items: center;"><Icon name="globe" size={16} /> ampliosystemsltd.com</span>
          <span style="display: flex; gap: 8px; align-items: center;"><Icon name="building-2" size={16} /> Amplio Systems Ltd</span>
        </div>
      </div>
    </div>
    <div style="margin-top: var(--space-16); padding-top: var(--space-6); border-top: 1px solid var(--border-inverse); display: flex; justify-content: space-between; font-family: var(--font-body); font-size: var(--text-xs); color: var(--text-inverse-muted);">
      <span>&copy; 2026 Amplio Systems Ltd</span>
      <span>Brand guidelines v1.0</span>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-16);
  }
  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-10); }
  }
</style>
